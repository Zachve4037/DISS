<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.RouteGUI">
  <grid id="27dc6" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="800" height="528"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="e001" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Secelt route:"/>
        </properties>
      </component>
      <component id="e002" class="javax.swing.JComboBox" binding="routeComboBox">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="e003" class="javax.swing.JButton" binding="startButton">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="40"/>
          </grid>
        </constraints>
        <properties>
          <text value="Start"/>
        </properties>
      </component>
      <component id="aaa01" class="javax.swing.JLabel" binding="routeLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Route -"/>
        </properties>
      </component>
      <component id="aaa02" class="javax.swing.JLabel" binding="replicationLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Replication count: 0"/>
        </properties>
      </component>
      <component id="aaa03" class="javax.swing.JLabel" binding="avgTimeLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Average time: -"/>
        </properties>
      </component>
      <component id="cafa6" class="javax.swing.JButton" binding="pauseButton">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="40"/>
          </grid>
        </constraints>
        <properties>
          <text value="Pause"/>
        </properties>
      </component>
      <component id="28346" class="javax.swing.JButton" binding="stopButton">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="40"/>
          </grid>
        </constraints>
        <properties>
          <text value="Stop"/>
        </properties>
      </component>
      <component id="bbb01" class="org.jfree.chart.ChartPanel" binding="chartPanel" custom-create="true">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="760" height="300"/>
          </grid>
        </constraints>
        <properties/>
      </component>
    </children>
  </grid>
</form>
